# Copia este archivo a .env y ajusta los valores antes de correr la API.

# --- Base de datos ---
# SQLite local por defecto. Para usar la Postgres de un proyecto de Supabase,
# ver README.md sección "Migrar a Postgres/S3" y reemplaza por la cadena de
# conexión de tu proyecto, ej:
# DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
DATABASE_URL="file:./dev.db"

# --- Servidor ---
PORT=4000
NODE_ENV=development

# Origen público desde el que se sirven los archivos de /uploads
# (usado por LocalDiskStorageAdapter para construir URLs absolutas).
# En producción, el dominio público real de la API.
API_PUBLIC_URL="http://localhost:4000"

# --- Orígenes permitidos (CORS), separados por coma ---
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# --- Secretos de sesión (generar valores propios, nunca reutilizar estos) ---
JWT_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"

# --- Almacenamiento de archivos ---
# local | s3
STORAGE_DRIVER=local

# Solo se usan si STORAGE_DRIVER=s3
# Ejemplo con un bucket público "dsc-isc-uploads" en Supabase Storage:
#   S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
#   S3_REGION=<región del proyecto, ej. us-east-1>
#   S3_BUCKET=dsc-isc-uploads
#   S3_ACCESS_KEY_ID=<Access Key ID de Storage > S3 Access Keys>
#   S3_SECRET_ACCESS_KEY=<Secret Access Key de Storage > S3 Access Keys>
#   S3_PUBLIC_BASE_URL=https://<project-ref>.supabase.co/storage/v1/object/public/dsc-isc-uploads
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
