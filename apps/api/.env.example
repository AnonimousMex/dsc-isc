# Copia este archivo a .env y ajusta los valores antes de correr la API.

# --- Base de datos ---
# SQLite local por defecto. Para migrar a Postgres, ver README.md sección
# "Migrar a Postgres/S3".
DATABASE_URL="file:./prisma/dev.db"

# --- Servidor ---
PORT=4000
NODE_ENV=development

# --- Orígenes permitidos (CORS), separados por coma ---
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# --- Secretos de sesión (generar valores propios, nunca reutilizar estos) ---
JWT_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"

# --- Almacenamiento de archivos ---
# local | s3
STORAGE_DRIVER=local

# Solo se usan si STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
